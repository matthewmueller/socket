package socket

type parser Peg {
  url uri
}

URL <- URI End
    / OnlyPath End
    / FdScheme End
    / Host End
    / Scheme End
    / OnlyPort End

URI <- < Scheme '//' Host URLPath? Query? Fragment? > {
  p.url.Raw = text
}

Scheme <- FdScheme / AnySchema

FdScheme <- < 'fd:' [0-9]+ > {
  p.url.Scheme = "fd"
  p.url.Host = text[3:]
}

AnySchema <- < [a-zA-Z][a-zA-Z+0-9]* ':' > {
  p.url.Scheme = text[:len(text)-1]
}

Host <- IPPort / HostNamePort / IPV4 / HostName / BracketsPort / Brackets / Path

IPPort <- IP ':' Port
HostNamePort <- HostName ':' Port
BracketsPort <- Brackets ':' Port

IP <- IPV4

IPV4 <- < [0-9]+ '.' [0-9]+ '.' [0-9]+ '.' [0-9]+ > {
  p.url.Host = text
}

HostName <- < [a-zA-Z][a-zA-Z0-9]* > {
  p.url.Host = text
}

OnlyPort <- ':' Port URLPath? Query? Fragment? / Port URLPath? Query? Fragment?

Port <- < PortRange / NumericPort > {
  p.url.Port = text
}

PortRange <- [1-9] [0-9]* 'x'+
NumericPort <- '0' / [1-9] [0-9]*

Query <- '?' < (!'#' .)* > {
  p.url.RawQuery = text
}

Fragment <- '#' < .* > {
  p.url.Fragment = text
}

OnlyPath <- Path {
  p.url.Scheme = "unix"
}

Path <- RelPath / AbsPath

URLPath <- < '/' (!('?' / '#') .)* > {
  p.url.Path = text
}

RelPath <- < '.' '/' .* > {
  p.url.Path = text
}

AbsPath <- < '/' .* > {
  p.url.Path = text
}

Brackets <- '[::]' {
  p.url.Host = "[::]"
}

End
  <- !.
